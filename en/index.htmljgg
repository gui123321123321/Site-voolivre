<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="../style.css">

    <meta
        name="description"
        content="Voa Rio! — Rio at your feet. The sky ahead."
    >

    <meta
        name="theme-color"
        content="#0b1118"
    >

    <title>Voa Rio! | Rio at your feet. The sky ahead.</title>
</head>


<body>


    <!-- ==============================
         CABEÇALHO
    ============================== -->

    <header class="cabecalho">

        <div class="cabecalho-conteudo">
    <a
        href="#inicio"
        class="logo"
    >
        Voa Rio!
    </a>

    <div class="seletor-idioma">
    <button type="button" data-idioma="pt">
        <span class="bandeira">🇧🇷</span>
        <span>PT</span>
    </button>

    <button type="button" data-idioma="en">
        <span class="bandeira">🇺🇸</span>
        <span>EN</span>
    </button>

    <button type="button" data-idioma="es">
        <span class="bandeira">🇪🇸</span>
        <span>ES</span>
    </button>
    </div>
        </div>

    </header>



    <!-- ==============================
         ABERTURA
    ============================== -->

    <main>

        <section
            class="hero"
            id="inicio"
        >

            <div class="hero-conteudo">


                <p class="hero-rotulo">
                    Free flight in Rio de Janeiro
                </p>


                <h1 class="hero-titulo">
                    Voa Rio!
                </h1>


                <p class="hero-slogan">
                    Rio at your feet.<br>
                    The sky ahead.
                </p>


                <a
                    href="https://wa.me/5521975899356?text=Hello!%20I%20have%20some%20questions%20about%20Voa%20Rio!%20flights%20and%20would%20like%20to%20learn%20more%20or%20book%20my%20flight."
                    class="botao-hero"
                >
                    I want to fly
                </a>


            </div>

        </section>

                <!-- ==============================
             MODALIDADES
        ============================== -->

        <section class="modalidades" id="modalidades">

            <div class="modalidades-introducao">

                <p class="modalidades-rotulo">
                    Two ways to fly
                </p>

                <h2 class="modalidades-titulo">
                    Choose how you want to experience Rio from the sky.
                </h2>

                <p class="modalidades-texto">
                    At Pedra Bonita, two disciplines let you experience
                    free flight in different ways: hang gliding and
                    paragliding.
                </p>

            </div>


            <div class="modalidades-lista">


                <!-- ==========================
                     CARD ASA-DELTA
                =========================== -->

                <article class="modalidade modalidade-asa">

                    <div class="modalidade-imagem">

                        <img
                            src="../asa-delta.jpg"
                            alt="Tandem hang gliding flight at Pedra Bonita"
                        >

                    </div>


                    <div class="modalidade-conteudo">

                        <p class="modalidade-rotulo">
                            Hang gliding
                        </p>

                        <h3>
                            A classic way to experience Rio from the sky.
                        </h3>

                        <p>
                            The experience begins at Pedra Bonita and continues
                            toward São Conrado, accompanied by an
                            instructor pilot throughout the flight.
                        </p>

                        <a
                            href="asa-delta.html"
                            class="modalidade-link"
                        >
                            Learn more
                            <span>→</span>
                        </a>

                    </div>

                </article>



                <!-- ==========================
                     CARD PARAPENTE
                =========================== -->

                <article class="modalidade modalidade-parapente">

                    <div class="modalidade-imagem">

                        <img
                            src="../parapente.jpg"
                            alt="Tandem paragliding flight at Pedra Bonita"
                        >

                    </div>


                    <div class="modalidade-conteudo">

                        <p class="modalidade-rotulo">
                            Paragliding
                        </p>

                        <h3>
                            Another way to take off from Pedra Bonita.
                        </h3>

                        <p>
                            On a tandem paragliding flight, you take off from
                            Pedra Bonita accompanied by an instructor pilot
                            and experience São Conrado from a new
                            perspective.
                        </p>

                        <a
                            href="parapente.html"
                            class="modalidade-link"
                        >
                            Learn more
                            <span>→</span>
                        </a>

                    </div>

                </article>


            </div>

        </section>



        <!-- ==============================
             ESTILO — MODALIDADES
        ============================== -->
</main>

<!-- BLOCO 3 — UMA NOVA PERSPECTIVA -->
<section class="perspectiva" id="perspectiva">

  <div class="perspectiva-imagem">

    <img
      src="../perspectiva.jpg"
      alt="View of Rio de Janeiro from Pedra Bonita"
    >

  </div>

  <div class="perspectiva-conteudo">

    <div class="perspectiva-linha"></div>

    <span class="perspectiva-rotulo">
      A new perspective
    </span>

    <h2 class="perspectiva-titulo">
      Have you ever imagined seeing Rio like this?
    </h2>

    <p class="perspectiva-texto">
      From Pedra Bonita, mountains, sea and city form a landscape
      that takes on another dimension from above.
    </p>

    <p class="perspectiva-texto">
      The flight heads toward São Conrado, revealing Rio from
      a perspective you cannot experience from the ground.
    </p>

    <p class="perspectiva-destaque">
      Maybe your next point of view is the sky.
    </p>

  </div>

</section>

    <!-- BLOCO 4 — NOSSA HISTÓRIA -->
<section class="historia" id="historia">

  <div class="historia-conteudo">

    <div class="historia-topo">

      <span class="historia-rotulo">
        Our story
      </span>

      <h2 class="historia-titulo">
        Flight is part of our story.
      </h2>

    </div>

    <div class="historia-corpo">

      <div class="historia-imagem">

        <img
          src="../historia.jpg"
          alt="Pedra Bonita and the Rio de Janeiro landscape"
        >

      </div>

      <div class="historia-texto">

        <p class="historia-abertura">
          The sky has always been part of our landscape.
        </p>

        <p class="historia-paragrafo">
          For those who come to Pedra Bonita to discover free flight,
          that place may be the beginning of an experience. For us,
          it is also part of our story.
        </p>

        <p class="historia-paragrafo">
          We live in Pedra Bonita and are part of a traditional
          family from the area, where our connection with free flight
          spans generations.
        </p>

        <p class="historia-paragrafo">
          Voa Rio! was born from this connection with the place,
          with flight and with our own history.
        </p>

        <p class="historia-assinatura">
          Experience Rio from the sky, through the eyes of those who live here.
        </p>

      </div>

    </div>

  </div>

</section>

<!-- BLOCO 5 — COMO FUNCIONA -->
<section class="processo" id="como-funciona">

  <div class="processo-conteudo">

    <div class="processo-topo">

      <span class="processo-rotulo">
        How it works
      </span>

      <h2 class="processo-titulo">
        From the first contact to the flight.
      </h2>

      <p class="processo-introducao">
        You do not need to know how everything works beforehand.
        We guide you through every step so you know what to expect
        before arriving at Pedra Bonita.
      </p>

    </div>

    <div class="processo-lista">

      <div class="processo-etapa">

        <div class="processo-numero">
          01
        </div>

        <div>
          <h3 class="processo-etapa-titulo">
            Get in touch
          </h3>

          <p class="processo-etapa-texto">
            You let us know on WhatsApp which days you are available
            to take the flight.
          </p>
        </div>

      </div>

      <div class="processo-etapa">

        <div class="processo-numero">
          02
        </div>

        <div>
          <h3 class="processo-etapa-titulo">
            We find the best time
          </h3>

          <p class="processo-etapa-texto">
            The team monitors weather and wind conditions and advises
            you on the best day and time for the flight.
          </p>
        </div>

      </div>

      <div class="processo-etapa">

        <div class="processo-numero">
          03
        </div>

        <div>
          <h3 class="processo-etapa-titulo">
            Meeting and registration
          </h3>

          <p class="processo-etapa-texto">
            On the scheduled day, you meet the team at the
            São Conrado Free Flight Club and complete the required registration
            before heading to Pedra Bonita.
          </p>
        </div>

      </div>

      <div class="processo-etapa">

        <div class="processo-numero">
          04
        </div>

        <div>
          <h3 class="processo-etapa-titulo">
            Flight preparation
          </h3>

          <p class="processo-etapa-texto">
            The equipment is prepared and checked. Before takeoff,
            the pilot explains the safety procedures,
            takeoff, landing and the instructions to follow.
          </p>
        </div>

      </div>

      <div class="processo-etapa">

        <div class="processo-numero">
          05
        </div>

        <div>
          <h3 class="processo-etapa-titulo">
            Flight and landing
          </h3>

          <p class="processo-etapa-texto">
            When conditions are suitable, takeoff is authorized.
            The pilot accompanies you throughout the flight,
            until landing at Pepino Beach.
          </p>
        </div>

      </div>

    </div>

  </div>

</section>

    <!-- BLOCO 6 — O CÉU TAMBÉM DECIDE -->
<section class="ceu" id="ceu">

  <img
    class="ceu-imagem"
    src="../ceu.jpg"
    alt="View of the sky over Rio de Janeiro"
  >

  <div class="ceu-conteudo">

    <span class="ceu-rotulo">
      The sky decides too
    </span>

    <h2 class="ceu-titulo">
      Not every day is a flying day.
    </h2>

    <p class="ceu-texto">
      Free flight depends on weather and wind conditions.
      That is why the team monitors the forecast and local conditions
      to advise you on the best time to fly.
    </p>

    <p class="ceu-destaque">
      Flight conditions are monitored before takeoff. If the minimum requirements
        for the flight are not met, takeoff is not authorized.
        In that case, the flight can be rescheduled for a more favorable time.
    </p>

  </div>

</section>

<!-- BLOCO 7 — ANTES DE VOAR -->
<section class="antes-voar" id="antes-de-voar">

  <div class="antes-voar-conteudo">

    <div class="antes-voar-topo">

      <span class="antes-voar-rotulo">
        Before you fly
      </span>

      <h2 class="antes-voar-titulo">
        A few things you need to know.
      </h2>

      <p class="antes-voar-introducao">
        To make your experience as smooth as possible,
        there are a few important details to consider
        before the flight.
      </p>

    </div>

    <div class="antes-voar-grid">

      <div class="antes-voar-item">

        <h3 class="antes-voar-item-titulo">
          Never flown before?
        </h3>

        <p class="antes-voar-item-texto">
          No previous experience is required.
          Before takeoff, the pilot explains
          the procedures and instructions you need to follow.
        </p>

      </div>

      <div class="antes-voar-item">

        <h3 class="antes-voar-item-titulo">
          Age
        </h3>

        <p class="antes-voar-item-texto">
          The activity is intended for people aged 18 and over.
          Minors aged 14 and above may fly with a parent
          or legal guardian present during registration.
        </p>

      </div>

      <div class="antes-voar-item">

        <h3 class="antes-voar-item-titulo">
          Weight
        </h3>

        <p class="antes-voar-item-texto">
          There is no single weight limit for every flight.
          The possibility of taking part depends on the pilot,
          the equipment and the flight conditions.
        </p>

      </div>

      <div class="antes-voar-item">

        <h3 class="antes-voar-item-titulo">
          Footwear
        </h3>

        <p class="antes-voar-item-texto">
          Closed-toe footwear is recommended.
          Sandals or flip-flops may only be used
          if they are securely fastened to your feet.
        </p>

      </div>

      <div class="antes-voar-item">

        <h3 class="antes-voar-item-titulo">
          Your belongings
        </h3>

        <p class="antes-voar-item-texto">
          Small personal items can be stored
          in the equipment compartment. Backpacks and larger items
          are taken by a team member to the landing site.
        </p>

      </div>

      <div class="antes-voar-item">

        <h3 class="antes-voar-item-titulo">
          How to get there
        </h3>

        <p class="antes-voar-item-texto">
          The meeting point is at the São Conrado Free Flight Club.
          Directions to the exact location are sent via WhatsApp
          when the flight is booked.
        </p>

      </div>

    </div>

  </div>

</section>

<!-- BLOCO 8 — SEGURANÇA E PREPARAÇÃO -->
<section class="seguranca" id="seguranca">

  <div class="seguranca-conteudo">

    <div class="seguranca-topo">

      <span class="seguranca-rotulo">
        Safety and preparation
      </span>

      <h2 class="seguranca-titulo">
        Before you fly, tudo precisa estar pronto.
      </h2>

      <p class="seguranca-introducao">
        Preparation is part of the flight. Equipment, local conditions
        and procedures are checked before takeoff.
      </p>

    </div>

    <div class="seguranca-grid">

      <div class="seguranca-item">

        <span class="seguranca-numero">
          01
        </span>

        <h3 class="seguranca-item-titulo">
          Equipment prepared
        </h3>

        <p class="seguranca-item-texto">
          The equipment is assembled and prepared according to the
          procedures for the discipline before takeoff.
        </p>

      </div>

      <div class="seguranca-item">

        <span class="seguranca-numero">
          02
        </span>

        <h3 class="seguranca-item-titulo">
          Equipment checked
        </h3>

        <p class="seguranca-item-texto">
          After assembly, the necessary checks are carried out
          before the flight can be cleared.
        </p>

      </div>

      <div class="seguranca-item">

        <span class="seguranca-numero">
          03
        </span>

        <h3 class="seguranca-item-titulo">
          Pre-takeoff instructions
        </h3>

        <p class="seguranca-item-texto">
          The pilot explains the safety procedures, takeoff,
          landing and the instructions to follow during the activity.
        </p>

      </div>

      <div class="seguranca-item">

        <span class="seguranca-numero">
          04
        </span>

        <h3 class="seguranca-item-titulo">
          Conditions monitored
        </h3>

        <p class="seguranca-item-texto">
          Weather and wind conditions are monitored before and during
          the preparation process for takeoff.
        </p>

      </div>

      <div class="seguranca-item">

        <span class="seguranca-numero">
          05
        </span>

        <h3 class="seguranca-item-titulo">
          Takeoff clearance
        </h3>

        <p class="seguranca-item-texto">
          Takeoff is cleared when the conditions required
          for the flight are present.
        </p>

      </div>

      <div class="seguranca-item">

        <span class="seguranca-numero">
          06
        </span>

        <h3 class="seguranca-item-titulo">
          If conditions are not sufficient
        </h3>

        <p class="seguranca-item-texto">
          If the conditions required for the flight are not present,
          takeoff is not authorized and the flight may be rescheduled.
        </p>

      </div>

    </div>

    <div class="seguranca-destaque">

      <p>
        Takeoff happens when the conditions required
        for the flight are present.
      </p>

    </div>

  </div>

</section>

    <!-- BLOCO 9 — REGISTROS DO VOO -->
<section class="registro" id="registros">

  <div class="registro-conteudo">

    <span class="registro-rotulo">
      Flight recordings
    </span>

    <h2 class="registro-titulo">
      One flight. Many perspectives.
    </h2>

    <p class="registro-texto">
      Registros em <strong>GoPro</strong> e <strong>360°</strong>
      capture the experience of the sky from different perspectives
      and in high image quality.
    </p>

    <p class="registro-destaque">
      You choose how you want to relive the flight.
    </p>

  </div>

</section>

<!-- BLOCO 10 — PERGUNTAS FREQUENTES -->

<section class="faq" id="faq">

    <div class="faq-conteudo">

        <p class="secao-etiqueta">Frequently asked questions</p>

        <h2>Before you fly, algumas respostas.</h2>

        <div class="faq-lista">

            <div class="faq-item">
                <button class="faq-pergunta" type="button">
                    <span>How is the pilot for my flight selected?</span>
                    <span class="faq-icone">+</span>
                </button>

                <div class="faq-resposta">
                    <p>
                        The pilot is selected according to availability
                        for the chosen date and time.
                    </p>
                </div>
            </div>


            <div class="faq-item">
                <button class="faq-pergunta" type="button">
                    <span>Where will we land?</span>
                    <span class="faq-icone">+</span>
                </button>

                <div class="faq-resposta">
                    <p>
                        The official landing site is Pepino Beach.
                    </p>
                </div>
            </div>


            <div class="faq-item">
                <button class="faq-pergunta" type="button">
                    <span>Can I take the flight without anyone accompanying me?</span>
                    <span class="faq-icone">+</span>
                </button>

                <div class="faq-resposta">
                    <p>
                        Yes. A tandem flight is carried out exclusively by the pilot
                        and the passenger.
                    </p>
                </div>
            </div>


            <div class="faq-item">
                <button class="faq-pergunta" type="button">
                    <span>Can I bring someone with me on the day of the flight?</span>
                    <span class="faq-icone">+</span>
                </button>

                <div class="faq-resposta">
                    <p>
                        Yes. The person accompanying you may go
                        to the free-flight launch ramp. After takeoff, they can return
                        with a member of the team.
                    </p>
                </div>
            </div>


            <div class="faq-item">
                <button class="faq-pergunta" type="button">
                    <span>When is payment made?</span>
                    <span class="faq-icone">+</span>
                </button>

                <div class="faq-resposta">
                    <p>
                        Payment is made after the flight.
                    </p>
                </div>
            </div>


            <div class="faq-item">
                <button class="faq-pergunta" type="button">
                    <span>What payment methods are accepted?</span>
                    <span class="faq-icone">+</span>
                </button>

                <div class="faq-resposta">
                    <p>
                        We accept Pix, cash, and credit or debit cards.
                    </p>
                </div>
            </div>


            <div class="faq-item">
                <button class="faq-pergunta" type="button">
                    <span>Are the recordings delivered on the same day?</span>
                    <span class="faq-icone">+</span>
                </button>

                <div class="faq-resposta">
                    <p>
                        Yes. Shortly after landing, the available recordings
                        are presented so you can watch them
                        and choose which ones you would like to keep.
                    </p>
                </div>
            </div>


            <div class="faq-item">
                <button class="faq-pergunta" type="button">
                    <span>Can I take the flight on a special date or occasion?</span>
                    <span class="faq-icone">+</span>
                </button>

                <div class="faq-resposta">
                    <p>
                        Yes. The flight can take place on any day when
                        conditions are favorable for the activity.
                    </p>
                </div>
            </div>


            <div class="faq-item">
                <button class="faq-pergunta" type="button">
                    <span>Do I need to live in Rio de Janeiro to take the flight?</span>
                    <span class="faq-icone">+</span>
                </button>

                <div class="faq-resposta">
                    <p>
                        No. Voa Rio! welcomes people from other cities,
                        states and also from other countries.
                    </p>
                </div>
            </div>

        </div>

    </div>

</section>
<script>

/* ========================================
   FAQ — ABRIR E FECHAR
======================================== */

document.addEventListener("DOMContentLoaded", function () {

    const perguntas = document.querySelectorAll(".faq-pergunta");

    perguntas.forEach(function (pergunta) {

        pergunta.addEventListener("click", function () {

            const item = this.closest(".faq-item");
            const resposta = item.querySelector(".faq-resposta");

            const estavaAberto = item.classList.contains("aberto");


            /* Fecha todos */

            document.querySelectorAll(".faq-item").forEach(function (outroItem) {

                outroItem.classList.remove("aberto");

                const outraResposta =
                    outroItem.querySelector(".faq-resposta");

                outraResposta.style.maxHeight = "0px";
                outraResposta.style.opacity = "0";
                outraResposta.style.paddingBottom = "0px";

            });


            /* Abre somente se estava fechado */

            if (!estavaAberto) {

                item.classList.add("aberto");

                resposta.style.maxHeight =
                    resposta.scrollHeight + "px";

                resposta.style.opacity = "1";

                resposta.style.paddingBottom = "26px";

            }

        });

    });

});

</script>


<!-- BLOCO 11 — CHAMADA FINAL -->

<section class="cta-final">

    <div class="cta-final-conteudo">

        <h2>
            Ready to experience Rio from another point of view?
        </h2>

        <p>
            Talk to our team to learn more and book your flight.
        </p>

        <a
            class="chamada-botao"
            href="https://wa.me/5521975899356?text=Hello!%20I%20have%20some%20questions%20about%20Voa%20Rio!%20flights%20and%20would%20like%20to%20learn%20more%20or%20book%20my%20flight."
            target="_blank"
            rel="noopener noreferrer"
        >
            More information and booking
        </a>

    </div>

</section>

    <!-- RODAPÉ -->
<footer class="rodape">
  <div class="rodape-conteudo">
    <div class="rodape-marca">
      <h2>Voa Rio!</h2>
      <p>Rio at your feet. The sky ahead.</p>
    </div>
  </div>

  <div class="rodape-base">
    <p>Voa Rio!</p>
    <p>Experience Rio from the sky.</p>
  </div>
</footer>


<!-- ABA FLUTUANTE DO WHATSAPP -->
<a
  class="whatsapp-flutuante"
  href="https://wa.me/5521975899356?text=Hello!%20I%20have%20some%20questions%20about%20Voa%20Rio!%20flights%20and%20would%20like%20to%20learn%20more%20or%20book%20my%20flight."
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contact us pelo WhatsApp"
>
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      d="M20.52 3.48A11.87 11.87 0 0 0 12.06 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.15 1.6 5.96L.05 24l6.28-1.65a11.9 11.9 0 0 0 5.73 1.46h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.17-3.45-8.43ZM12.06 21.8h-.01a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.73.98 1-3.64-.23-.37a9.9 9.9 0 0 1-1.52-5.28C2.16 6.44 6.6 2 12.06 2a9.87 9.87 0 0 1 7.03 2.92 9.88 9.88 0 0 1 2.91 7.04c0 5.46-4.44 9.9-9.94 9.9Zm5.43-7.42c-.3-.15-1.77-.87-2.05-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.96 1.17-.18.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.68-1.63-.93-2.23-.25-.6-.5-.52-.68-.53h-.58c-.2 0-.52.07-.8.37-.28.3-1.05 1.03-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.12 3.24 5.14 4.55.72.31 1.28.5 1.72.64.72.23 1.37.2 1.89.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.07-.12-.27-.2-.57-.35Z"
    />
  </svg>

  <span>Contact us</span>
</a>
<script>
document.addEventListener("DOMContentLoaded", function () {

  const abaWhatsApp = document.querySelector(".whatsapp-flutuante");

  const botoesWhatsApp = document.querySelectorAll(
    ".botao-cabecalho, .botao-hero, .chamada-botao"
  );

  if (!abaWhatsApp || !botoesWhatsApp.length) {
    return;
  }

  const elementosVisiveis = new Set();

  const observador = new IntersectionObserver(
    function (entradas) {

      entradas.forEach(function (entrada) {

        if (entrada.isIntersecting) {
          elementosVisiveis.add(entrada.target);
        } else {
          elementosVisiveis.delete(entrada.target);
        }

      });

      if (elementosVisiveis.size > 0) {
        abaWhatsApp.classList.add("oculta");
      } else {
        abaWhatsApp.classList.remove("oculta");
      }

    },
    {
      threshold: 0.15
    }
  );

  botoesWhatsApp.forEach(function (botao) {
    observador.observe(botao);
  });

});
</script>

<script src="../js/idioma.js"></script>
    
</body>

</html>
